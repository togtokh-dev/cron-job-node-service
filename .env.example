# =========================================================
# Cron Job Service — Environment Variables (template)
# =========================================================
# Энэ файлыг хуулж .env.development / .env.production болго.
# Нууц утгууд (JWT_SECRET, ADMIN_PASSWORD(_HASH), MONGODB_URI)-ийг
# ӨӨРИЙН утгаар бөглө. Энэ repo-д нууц утга бүү commit хий.

# ---------- App ----------
PORT=2003
# dev | staging | prod | test
SERVER=dev
NODE_ENV=development
NAME="cron-job-service"

# Public cron API prefix (backward-compat: ҮРГЭЛЖ /cron-job дор)
DOMAIN_PARAM="cron-job"

# ---------- Network / SSL ----------
SSL=false

# ---------- MongoDB ----------
MONGODB_URI="mongodb://localhost:27017/"
MONGODB_dbName="CRON_JOB"

# ---------- Admin нэвтрэлт (panel) ----------
# Ганц admin — зөвхөн env-ээс. Бүртгэл / нууц үг сэргээх БАЙХГҮЙ.
ADMIN_USERNAME="admin"
# Дараах 2-оос нэгийг нь бөглө:
#   ADMIN_PASSWORD      — энгийн текст нууц үг (dev-д хялбар)
#   ADMIN_PASSWORD_HASH — bcrypt hash (prod-д санал болгоно)
# Хоёулаа байвал HASH давуу.
#   hash үүсгэх: node -e "console.log(require('bcryptjs').hashSync('НУУЦҮГ',10))"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""

# JWT — panel-ийн нэвтрэлтийн token (prod/staging дээр ЗААВАЛ)
# Урт санамсаргүй нууц мөр: openssl rand -hex 32
JWT_SECRET=""
JWT_EXPIRESIN="7d"

# ---------- Log retention ----------
LOG_RETENTION_ENABLED=true
LOG_RETENTION_DAYS=30
LOG_RETENTION_CRON="0 3 * * *"

# ---------- CORS ----------
ENABLE_CORS=true
CORS_ORIGINS=""

# ---------- Feature toggles ----------
ENABLE_HELMET=true
ENABLE_MORGAN=true
ENABLE_RATE_LIMIT=true
ENABLE_HPP=true
ENABLE_COMPRESSION=true

# ---------- Rate limit ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300000

# ---------- Body limits ----------
JSON_LIMIT="5mb"
URLENCODED_LIMIT="5mb"

# ---------- Swagger / OpenAPI docs ----------
ENABLE_SWAGGER=true
SWAGGER_PATH="/docs"
SWAGGER_USER="admin"
SWAGGER_PASSWORD=""

# ---------- Logger (stdout) ----------
# debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# json | pretty
LOG_FORMAT=pretty

# ---------- Monitoring ----------
NEWRELIC=false
KEY_NEW_RELIC_LICENSE=""
