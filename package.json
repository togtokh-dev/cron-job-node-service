{
  "name": "cron-job-backend",
  "version": "1.0.2",
  "description": "Cron Job backend — хуваарьт HTTP ажлуудыг удирдах API + admin panel",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k -n \"TS,API\" -c \"cyan,green\" \"npm:watch-ts\" \"npm:watch-api\"",
    "staging": "cross-env NODE_ENV=staging node dist/server.js",
    "production": "cross-env NODE_ENV=production node dist/server.js",
    "start": "cross-env NODE_ENV=production node dist/server.js",
    "build": "npm run build-ts",
    "build-ts": "tsc",
    "serve": "node dist/server.js",
    "watch-api": "nodemon dist/server.js",
    "watch-ts": "tsc -w",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "clean": "rimraf dist",
    "test": "cross-env NODE_ENV=test jest --forceExit --detectOpenHandles"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/togtokh-dev/projects/cron-job/backend.git"
  },
  "author": "TOGTOKH.DEV",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-and-time": "^3.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "ip": "^2.0.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/ip": "^1.1.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.12",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.20.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
