# Cron Job Service — production
# prod дээр JWT_SECRET, ADMIN_PASSWORD(_HASH), SWAGGER_PASSWORD ЗААВАЛ бөгл.
PORT=2003
SERVER=prod
NODE_ENV=production
NAME="cron-job-service"
DOMAIN_PARAM="cron-job"

SSL=false

MONGODB_URI=""
MONGODB_dbName="CRON_JOB"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""

JWT_SECRET=""
JWT_EXPIRESIN="7d"

LOG_RETENTION_ENABLED=true
LOG_RETENTION_DAYS=30
LOG_RETENTION_CRON="0 3 * * *"

ENABLE_CORS=true
CORS_ORIGINS=""

ENABLE_HELMET=true
ENABLE_MORGAN=true
ENABLE_RATE_LIMIT=true
ENABLE_HPP=true
ENABLE_COMPRESSION=true

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300000

JSON_LIMIT="5mb"
URLENCODED_LIMIT="5mb"

ENABLE_SWAGGER=true
SWAGGER_PATH="/docs"
SWAGGER_USER="admin"
SWAGGER_PASSWORD=""

LOG_LEVEL=info
LOG_FORMAT=pretty

NEWRELIC=false
KEY_NEW_RELIC_LICENSE=""
